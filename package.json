{
	"name": "bidijkstra",
	"version": "0.6.3",
	"description": "bi-directional dijkstra search",
	"main": "index.js",
	"scripts": {
		"lint": "eslint **/*.js --ignore-path .gitignore",
		"pretest": "npm install",
		"preversion": "npm run test",
		"version": "",
		"postversion": "git push && git push --tags && npm publish",
		"test": "npm run lint && node --test ./tests/*.spec.js",
		"start": "node examples.js"
	},
	"Author": "john@invisiblearchitects.com",
	"license": "MIT",
	"devDependencies": {
		"eslint": "^5.16.0",
		"husky": "^8.0.3",
		"nodemon": "^1.19.4"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/invisiblegaudi/bidijkstra"
	},
	"eslintIgnore": [
		"./node_modules/*"
	],
	"husky": {
		"hooks": {
			"pre-commit": "npm run lint",
			"pre-push": "npm run test",
			"post-merge": "npm install && npm run test",
			"post-rebase": "npm run test"
		}
	},
  "publishConfig": { "registry": "https://npm.pkg.github.com/" }
}
